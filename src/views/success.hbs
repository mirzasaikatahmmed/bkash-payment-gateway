{{>header}}
<div class="result-page">
  <div class="card result-card success-card">
    <div class="result-icon success-icon">&#10003;</div>
    <h1>Payment Successful!</h1>
    <p>Your payment has been processed successfully.</p>

    {{#if paymentId}}
    <div class="info-box">
      <p><strong>Payment ID:</strong> {{paymentId}}</p>
    </div>
    {{/if}}

    <div class="actions">
      <a href="/" class="btn btn-primary">Make Another Payment</a>
      <a href="/transactions" class="btn btn-outline">View Transactions</a>
    </div>
  </div>
</div>
{{>footer}}
